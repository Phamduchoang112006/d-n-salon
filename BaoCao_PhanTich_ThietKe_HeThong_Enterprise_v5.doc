<p style="line-height:1.5; margin:8px 0;">int co_san</p>
<p style="line-height:1.5; margin:8px 0;">string tu_ke_kho</p>
<p style="line-height:1.5; margin:8px 0;">}</p>

<p style="line-height:1.5; margin:8px 0;">PHYSICAL_COPIES {</p>
<p style="line-height:1.5; margin:8px 0;">int id PK</p>
<p style="line-height:1.5; margin:8px 0;">int book_id FK</p>
<p style="line-height:1.5; margin:8px 0;">string barcode UK</p>
<p style="line-height:1.5; margin:8px 0;">string tu_ke_kho</p>
<p style="line-height:1.5; margin:8px 0;">string tinh_trang_hao_mon</p>
