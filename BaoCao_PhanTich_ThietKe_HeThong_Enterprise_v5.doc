<p style="line-height:1.5; margin:8px 0;">READERS ||--o{ BOOK_DONATIONS : "quyên góp sách"</p>
<p style="line-height:1.5; margin:8px 0;">READERS ||--o{ CHAT_MESSAGES : "gửi tin nhắn chat"</p>
<p style="line-height:1.5; margin:8px 0;">READERS ||--o{ USER_NOTIFICATIONS : "nhận thông báo"</p>
<p style="line-height:1.5; margin:8px 0;">READERS ||--o{ INVENTORY_LOCKS : "khóa bản sao"</p>

<p style="line-height:1.5; margin:8px 0;">RENTAL_ORDERS ||--|{ RENTAL_ORDER_ITEMS : "bao gồm chi tiết"</p>
<p style="line-height:1.5; margin:8px 0;">PHYSICAL_COPIES ||--o{ RENTAL_ORDER_ITEMS : "được mượn trong"</p>
<p style="line-height:1.5; margin:8px 0;">PHYSICAL_COPIES ||--o| INVENTORY_LOCKS : "bị tạm khóa"</p>
<p style="line-height:1.5; margin:8px 0;">MANGA_SERVICES ||--o{ MANGA_SERVICE_ORDERS : "cung cấp dịch vụ"</p>
<p style="line-height:1.5; margin:8px 0;">LIBRARY_EVENTS ||--o{ EVENT_REGISTRATIONS : "tổ chức"</p>

<p style="line-height:1.5; margin:8px 0;">READERS {</p>
<p style="line-height:1.5; margin:8px 0;">int id PK</p>
<p style="line-height:1.5; margin:8px 0;">string ma_doc_gia UK</p>
<p style="line-height:1.5; margin:8px 0;">string ho_ten</p>
<p style="line-height:1.5; margin:8px 0;">string email UK</p>
<p style="line-height:1.5; margin:8px 0;">string so_dien_thoai</p>
<p style="line-height:1.5; margin:8px 0;">double so_du_vi</p>
<p style="line-height:1.5; margin:8px 0;">double tien_coc_dong_bang</p>
<p style="line-height:1.5; margin:8px 0;">string loai_doc_gia</p>
<p style="line-height:1.5; margin:8px 0;">string trang_thai</p>
<p style="line-height:1.5; margin:8px 0;">}</p>

<p style="line-height:1.5; margin:8px 0;">BOOKS {</p>
<p style="line-height:1.5; margin:8px 0;">int id PK</p>
<p style="line-height:1.5; margin:8px 0;">string ma_sach UK</p>
<p style="line-height:1.5; margin:8px 0;">string isbn</p>
<p style="line-height:1.5; margin:8px 0;">string ten_sach</p>
<p style="line-height:1.5; margin:8px 0;">string tac_gia</p>
<p style="line-height:1.5; margin:8px 0;">double gia_bia</p>
<p style="line-height:1.5; margin:8px 0;">int ty_le_coc</p>
<p style="line-height:1.5; margin:8px 0;">double gia_thue_ngay</p>
