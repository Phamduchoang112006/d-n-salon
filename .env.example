# ========================================================
# LUMIÈRE HAIR STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env hoặc cấu hình trực tiếp tại db.php
# ========================================================

# Cấu hình Web Server & App
APP_NAME="LUMIÈRE Hair Studio"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Cấu hình Cơ Sở Dữ Liệu (Database Type: mysql / sqlite)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=lumiere_salon
MYSQL_USER=root
MYSQL_PASS=

# Cấu hình SQLite (Dự phòng khi không dùng MySQL)
SQLITE_FILE=data/salon.db

# Cấu hình Thanh toán VietQR Napas247 (Dynamic QR)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0912345678
VIETQR_ACCOUNT_NAME="LUMIERE HAIR STUDIO"
DEPOSIT_PERCENT=20

# Cấu hình SMS & Email Gateway Mock
NOTIFICATION_MOCK=true
